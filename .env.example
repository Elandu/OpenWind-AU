# Runtime mode
OPENWIND_ENVIRONMENT=production
OPENWIND_HOST=0.0.0.0
OPENWIND_PORT=8000
OPENWIND_TRUSTED_HOSTS=wind.example.com

# Required production datasets
OPENWIND_WIND_REGION_DATASET=/data/wind-regions.gpkg
# OPENWIND_WIND_REGION_LAYER=wind_regions
# OPENWIND_WIND_REGION_FIELD=wind_region
OPENWIND_DEM_PROVIDER=srtm

# Reviewed lookup overrides and approved digests.
# Do not populate reviewer metadata unless an independent review has actually occurred.
OPENWIND_VR_TABLE_PATH=/data/lookups/regional_wind_speeds.json
OPENWIND_MD_TABLE_PATH=/data/lookups/direction_multipliers.json
OPENWIND_MZCAT_TABLE_PATH=/data/lookups/terrain_height_multipliers.json
OPENWIND_MS_TABLE_PATH=/data/lookups/shielding_multipliers.json
OPENWIND_VR_EXPECTED_SHA256=
OPENWIND_MD_EXPECTED_SHA256=
OPENWIND_MZCAT_EXPECTED_SHA256=
OPENWIND_MS_EXPECTED_SHA256=

# Shared secret, minimum 32 UTF-8 bytes. Supply through the deployment secret store.
OPENWIND_RESULT_SIGNING_KEY=

# Optional local data caches
OPENWIND_MICROSOFT_FOOTPRINT_CACHE=/data/microsoft-building-footprints
OPENWIND_OSM_FOOTPRINT_CACHE=/data/osm-building-footprints
